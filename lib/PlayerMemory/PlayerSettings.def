// List of remembered settings - one line per setting.
//
//   SETTING(type, name, NVS key, default value)
//
// Settings of the player itself (Player library). The web panel settings are
// separate, in lib/PlayerWeb/WebSettings.def.
// New setting: add a line below, and the field PlayerMemory::name together with its
// reading, writing and restoring of the default value are generated automatically.
// Allowed types and rules: see lib/NvsSettings/NvsSettings.h.
// When you change the type or meaning of an existing setting, increase
// NVS_VERSION in PlayerMemory.h - old stored data will then be ignored.

//      type     name        key      default
SETTING(uint8_t, volume,     "vol",   56)      // volume 0..100
SETTING(bool,    muted,      "mute",  false)   // mute
SETTING(int8_t,  sidModel,   "model", -1)      // -1 auto, 0 = 6581, 1 = 8580
SETTING(bool,    autoPlay,   "auto",  true)    // play after power-on
SETTING(uint8_t, source,     "src",   0)       // active file source (enum SourceType)

// For every source: current folder, last file and its subtune (0 = default).
// New source = three lines here and one entry in PlayerMemory::forSource().
SETTING(String,  dirFlash,   "dirF",  "/")
SETTING(String,  fileFlash,  "fileF", "")
SETTING(uint8_t, songFlash,  "songF", 0)
SETTING(String,  dirSd,      "dirS",  "/")
SETTING(String,  fileSd,     "fileS", "")
SETTING(uint8_t, songSd,     "songS", 0)
SETTING(String,  dirDeepSid, "dirD",  "/")
SETTING(String,  fileDeepSid,"fileD", "")
SETTING(uint8_t, songDeepSid,"songD", 0)
