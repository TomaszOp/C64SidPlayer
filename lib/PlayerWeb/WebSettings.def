// Web panel settings - one line per setting (rules: lib/NvsSettings/NvsSettings.h).
//
//   SETTING(type, name, "NVS key", default value)
//
// When you change the type or meaning of an existing setting, increase NVS_VERSION in WebSettings.h.

//      type     name   key     default
SETTING(uint8_t, skin,  "skin", 0)    // page look (enum WebSkin, 0 = Modern)
